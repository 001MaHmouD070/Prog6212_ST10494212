@model IEnumerable<RaceDay.Web.Models.ViewModels.EventViewModel>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">
    <h2>Upcoming Events</h2>
    <hr />

    <div class="row">
        @foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@ev.EventName</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@ev.EventType - @ev.Distance km</h6>
                        <p class="card-text">
                            <strong>Date:</strong> @ev.EventDateAndTime.ToString("dd MMM yyyy HH:mm") <br />
                            <strong>Location:</strong> @ev.Location <br />
                            <strong>Status:</strong> <span class="badge bg-success">@ev.Status</span>
                        </p>
                        <a asp-action="Details" asp-route-id="@ev.EventID" class="btn btn-outline-primary w-100">View Details & Enrol</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>