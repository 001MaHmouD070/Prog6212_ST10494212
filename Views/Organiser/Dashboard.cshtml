@model IEnumerable<RaceDay.Web.Models.ViewModels.EventViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-success">Organiser Dashboard</h2>
        <a asp-action="CreateEvent" class="btn btn-success">+ Create New Event</a>
    </div>
    <hr />

    <div class="alert alert-info">
        <strong>Quick Tip:</strong> Below are the events currently on the platform. In a full production release, this would be filtered to only show events you created.
    </div>

    <div class="row">
        @foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100 border-success">
                    <div class="card-header bg-success text-white">
                        @ev.EventName
                    </div>
                    <div class="card-body">
                        <p class="card-text">
                            <strong>Date:</strong> @ev.EventDateAndTime.ToString("dd MMM yyyy") <br />
                            <strong>Type:</strong> @ev.EventType <br />
                            <strong>Location:</strong> @ev.Location
                        </p>
                        <a asp-action="ManageEvent" asp-route-id="@ev.EventID" class="btn btn-outline-success w-100">Manage Event</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>