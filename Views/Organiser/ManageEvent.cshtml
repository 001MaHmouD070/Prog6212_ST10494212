@model RaceDay.Web.Models.ViewModels.EventDetailsViewModel
@{
    ViewData["Title"] = "Manage " + Model.Event.EventName;
}

<div class="container mt-4">
    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["ErrorMessage"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Managing: <span class="text-success">@Model.Event.EventName</span></h2>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="alert alert-info">
        <strong>Event Details:</strong> @Model.Event.EventDateAndTime.ToString("dd MMM yyyy") | @Model.Event.Location | @Model.Event.Distance km
    </div>

    <div class="row mt-4">
        <!-- Left side: Existing Categories -->
        <div class="col-md-7">
            <h4>Existing Categories</h4>
            <hr />
            @if (Model.Categories.Count == 0)
            {
                <p class="text-muted">No categories added yet. Use the form to add one.</p>
            }
            else
            {
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Fee</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            <tr>
                                <td>@cat.CategoryName</td>
                                <td>@cat.MinAge - @cat.MaxAge</td>
                                <td>@cat.Gender</td>
                                <td>R @cat.EntryFee</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Add New Category</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateCategory" method="post">
                        <input type="hidden" name="eventId" value="@Model.Event.EventID" />

                        <div class="mb-3">
                            <label class="form-label">Category Name</label>
                            <input name="CategoryName" class="form-control" required placeholder="e.g. Senior Men 18-39" />
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Min Age</label>
                                <input name="MinAge" type="number" class="form-control" required />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Max Age</label>
                                <input name="MaxAge" type="number" class="form-control" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Gender</label>
                            <select name="Gender" class="form-select" required>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Open">Open</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Entry Fee (R)</label>
                            <input name="EntryFee" type="number" step="0.01" class="form-control" required />
                        </div>

                        <button type="submit" class="btn btn-success w-100">Add Category</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <h4>Event Enrolments & Results</h4>
            <hr />
            @if (Model.Enrolments.Count == 0)
            {
                <p class="text-muted">No participants have enrolled in this event yet.</p>
            }
            else
            {
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Race #</th>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Finish Time</th>
                            <th>Position</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var enrol in Model.Enrolments)
                        {
                            <tr>
                                <td>@enrol.RaceNumber</td>
                                <td>@enrol.ParticipantName</td>
                                <td>@enrol.CategoryName</td>
                                <td>@enrol.Status</td>
                                <td>@(string.IsNullOrEmpty(enrol.FinishTime) ? "-" : enrol.FinishTime)</td>
                                <td>@(enrol.Position.HasValue? enrol.Position.ToString() : "-")</td>
                                <td>
                                    @if (enrol.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Result Captured</span>
                                    }
                                    else
                                    {
                                        <!-- Form to capture result -->
                                        <form asp-action="CaptureResult" method="post" class="d-flex gap-2">
                                            <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                            <input type="hidden" name="enrolmentId" value="@enrol.EnrolmentID" />

                                            <input type="time" name="finishTime" step="1" class="form-control form-control-sm" required style="width: 120px;" title="Finish Time" />
                                            <input type="number" name="position" class="form-control form-control-sm" placeholder="Pos" required style="width: 70px;" min="1" />

                                            <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="row mt-5 mb-5">
        <div class="col-md-6">
            <h4>Upload Event Banner</h4>
            <hr />
            <form asp-action="UploadImage" method="post" enctype="multipart/form-data">
                <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                <div class="input-group">
                    <input type="file" name="file" class="form-control" accept="image/*" required />
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>