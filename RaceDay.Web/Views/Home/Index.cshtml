@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold" style="color: #e74c3c;">Welcome to RaceDay</h1>
    <p class="lead mt-3">The ultimate platform for South African running, walking, and cycling events.</p>

    @if (Context.Request.Cookies.ContainsKey(".RaceDay.Session"))
    {
        <div class="alert alert-success mt-4 d-inline-block px-5">
            <h4 class="alert-heading">You are logged in!</h4>
            <p>Head over to your dashboard to manage your events or view your race history.</p>
            <hr />
            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-success">Go to Dashboard</a>
        </div>
    }
    else
    {
        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 me-2">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark btn-lg px-4">Register</a>
        </div>
    }
</div>