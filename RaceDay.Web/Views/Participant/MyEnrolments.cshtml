@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2 class="text-primary">My Enrolments</h2>
    <p>Here are the events you have entered.</p>
    <hr />

    <div id="enrolments-container" class="row">
        <!-- JavaScript will inject the cards here -->
    </div>
</div>

@section Scripts {
    <script>
        // Get the JSON string passed from the controller
        var jsonString = @Html.Raw(Json.Serialize(ViewBag.EnrolmentsJson));

        // Parse the JSON
        var enrolments = JSON.parse(jsonString);
        var container = document.getElementById('enrolments-container');

        if (enrolments.length === 0) {
            container.innerHTML = '<div class="alert alert-info">You have not enrolled in any events yet. <a href="/Events">Browse Events</a></div>';
        } else {
            enrolments.forEach(function(enrolment) {
                // Determine badge color based on status
                var badgeColor = enrolment.status === 'Registered' ? 'success' :
                                 enrolment.status === 'Completed' ? 'primary' : 'secondary';

                var cardHtml = `
                    <div class="col-md-6 mb-4">
                        <div class="card shadow-sm">
                            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">${enrolment.eventName}</h5>
                                <span class="badge bg-${badgeColor}">${enrolment.status}</span>
                            </div>
                            <div class="card-body">
                                <p class="card-text">
                                    <strong>Date:</strong> ${new Date(enrolment.eventDate).toLocaleDateString()}<br />
                                    <strong>Category:</strong> ${enrolment.categoryName}<br />
                                    <strong>Race Number:</strong> <span class="fs-5 fw-bold text-danger">${enrolment.raceNumber}</span>
                                </p>
                                <button class="btn btn-outline-secondary btn-sm" disabled>View Details</button>
                            </div>
                        </div>
                    </div>
                `;
                container.innerHTML += cardHtml;
            });
        }
    </script>
}